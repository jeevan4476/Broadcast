#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"

# Optional Strangler-Fig selector: NVB_ENGINE=rust routes CLI/daemon to native Rust binaries
if [[ "${NVB_ENGINE:-python}" == "rust" ]]; then
    RUST_CLI="${SCRIPT_DIR}/rust/target/release/nvb-cli"
    if [[ ! -x "${RUST_CLI}" ]]; then
        RUST_CLI="${SCRIPT_DIR}/rust/target/debug/nvb-cli"
    fi
    if [[ -x "${RUST_CLI}" && "${1:-}" != "gui" ]]; then
        exec "${RUST_CLI}" "$@"
    fi
fi

LOCAL_VENV_PY="${SCRIPT_DIR}/.venv/bin/python"
USER_VENV_PY="${XDG_DATA_HOME:-$HOME/.local/share}/nv-broadcast/venv/bin/python"

# Prefer the Python 3.12 GPU/Neural AI venv (ONNX CUDA, MediaPipe, OpenCV, RNNoise)
PYTHON_BIN="$(command -v python3 || echo /usr/bin/python3)"
if [[ -x "${LOCAL_VENV_PY}" ]]; then
    PYTHON_BIN="${LOCAL_VENV_PY}"
elif [[ -x "${USER_VENV_PY}" ]]; then
    PYTHON_BIN="${USER_VENV_PY}"
fi

# Only fall back to system Python if user explicitly asked for legacy --gtk
if [[ "${1:-}" == "gui" ]]; then
    for arg in "$@"; do
        if [[ "${arg}" == "--gtk" ]]; then
            if ! "${PYTHON_BIN}" -c "import gi" >/dev/null 2>&1; then
                PYTHON_BIN="/usr/bin/python3"
            fi
            break
        fi
    done
fi

exec "${PYTHON_BIN}" -m nv_broadcast.cli "$@"
