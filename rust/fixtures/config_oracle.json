  "effect_catalog": {
    "noise_removal": {
      "section": "microphone",
      "label": "Noise Removal",
      "gpu_load": "Low",
      "description": "Uses neural AI (RNNoise) to eliminate fan, keyboard, and ambient background noise.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.85
        }
      }
    },
    "room_echo_removal": {
      "section": "microphone",
      "label": "Room Echo Removal",
      "gpu_load": "Low",
      "description": "Attenuates room reverberation and hollow wall reflections.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.5
        }
      }
    },
    "studio_voice": {
      "section": "microphone",
      "label": "Studio Voice",
      "gpu_load": "Medium",
      "description": "Neural cleanup paired with broadcast vocal EQ, warmth, and dynamic leveling.",
      "params": {
        "micProfile": {
          "type": "enum",
          "enum": [
            "default",
            "bright",
            "full",
            "warm"
          ],
          "default": "default"
        }
      }
    },
    "speaker_noise_removal": {
      "section": "speaker",
      "label": "Noise Removal",
      "gpu_load": "Low",
      "description": "Cleans background noise from incoming voice calls and meeting audio.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.75
        }
      }
    },
    "speaker_echo_removal": {
      "section": "speaker",
      "label": "Room Echo Removal",
      "gpu_load": "Low",
      "description": "Reduces room echo on incoming call audio.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.5
        }
      }
    },
    "background_blur": {
      "section": "camera",
      "label": "Background Blur",
      "gpu_load": "Medium",
      "description": "Uses neural portrait matting to smoothly blur your background.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.7
        },
        "mode": {
          "type": "enum",
          "enum": [
            "performance",
            "quality"
          ],
          "default": "quality"
        }
      }
    },
    "background_replace": {
      "section": "camera",
      "label": "Background Replacement",
      "gpu_load": "Medium",
      "description": "Replaces your background with a custom image or studio backdrop.",
      "params": {
        "imagePath": {
          "type": "path",
          "default": ""
        },
        "preset": {
          "type": "enum",
          "enum": [
            "studio_dark",
            "office_blur",
            "neon_green",
            "soft_daylight"
          ],
          "default": "studio_dark"
        }
      }
    },
    "background_remove": {
      "section": "camera",
      "label": "Background Removal",
      "gpu_load": "Medium",
      "description": "Replaces your background with chroma green (#00FF00) for OBS compositing.",
      "params": {
        "chromaColor": {
          "type": "string",
          "default": "#00ff00"
        }
      }
    },
    "auto_frame": {
      "section": "camera",
      "label": "Auto Frame",
      "gpu_load": "Low",
      "description": "Tracks your face and smoothly crops and zooms to keep you centered.",
      "params": {
        "zoom": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.35
        }
      }
    },
    "eye_contact": {
      "section": "camera",
      "label": "Eye Contact",
      "gpu_load": "Medium",
      "description": "Redirects your gaze toward the camera using real-time iris tracking.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.7
        },
        "lookAway": {
          "type": "bool",
          "default": true
        }
      }
    },
    "video_noise_removal": {
      "section": "camera",
      "label": "Video Noise Removal",
      "gpu_load": "Low",
      "description": "Strips low-light webcam grain using motion-aware temporal and bilateral denoising.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.6
        }
      }
    },
    "virtual_key_light": {
      "section": "camera",
      "label": "Virtual Key Light",
      "gpu_load": "Medium",
      "description": "Relights your face with adjustable cool-to-warm studio key lighting.",
      "params": {
        "warmth": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.5
        },
        "intensity": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.55
        }
      }
    },
    "vignette": {
      "section": "camera",
      "label": "Vignette",
      "gpu_load": "Low",
      "description": "Applies a soft studio edge darkening that can follow your face.",
      "params": {
        "strength": {
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "default": 0.4
        },
        "faceTracking": {
          "type": "bool",
          "default": true
        }
      }
    }
  },
